{
  "openapi": "3.1.0",
  "info": {
    "title": "Phone Transfer LAN API",
    "version": "1.0.0",
    "description": "Design contract. Endpoint availability is tracked in docs/implementation-status.md."
  },
  "servers": [
    {
      "url": "https://phone-transfer.local:47443"
    }
  ],
  "security": [
    {
      "mutualTls": []
    }
  ],
  "paths": {
    "/api/v1/info": {
      "get": {
        "operationId": "getServerInfo",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerInfo"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/shares": {
      "get": {
        "operationId": "listShares",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ShareList"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/shares/{shareId}/entries": {
      "get": {
        "operationId": "listEntries",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FileList"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "shareId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          }
        ]
      }
    },
    "/api/v1/transfers": {
      "post": {
        "operationId": "createTransfer",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transfer"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTransfer"
              }
            }
          }
        }
      }
    },
    "/api/v1/transfers/{transferId}": {
      "get": {
        "operationId": "getTransfer",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transfer"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "transferId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      },
      "delete": {
        "operationId": "cancelTransfer",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transfer"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "transferId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/transfers/{transferId}/complete": {
      "post": {
        "operationId": "completeTransfer",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transfer"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "transferId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ]
      }
    },
    "/api/v1/transfers/{transferId}/content": {
      "patch": {
        "operationId": "appendChunk",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Transfer"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "transferId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "Upload-Offset",
            "in": "header",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 0
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/octet-stream": {
              "schema": {
                "type": "string",
                "format": "binary"
              }
            }
          }
        }
      }
    },
    "/api/v1/shares/{shareId}/content": {
      "get": {
        "operationId": "downloadFile",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/octet-stream": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          },
          "206": {
            "description": "Single byte range. Strong SHA-256 ETag; stable snapshot required."
          }
        },
        "parameters": [
          {
            "name": "shareId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "path",
            "in": "query",
            "required": true,
            "schema": {
              "type": "string",
              "maxLength": 4096
            }
          },
          {
            "name": "Range",
            "in": "header",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "If-Match",
            "in": "header",
            "schema": {
              "type": "string"
            }
          }
        ]
      }
    },
    "/api/v1/text": {
      "post": {
        "operationId": "sendText",
        "responses": {
          "201": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TextEntry"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SendText"
              }
            }
          }
        }
      }
    },
    "/api/v1/text/history": {
      "get": {
        "operationId": "getTextHistory",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TextHistory"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string",
              "maxLength": 256
            }
          }
        ]
      }
    },
    "/pairing/v1/requests": {
      "post": {
        "operationId": "requestPairing",
        "responses": {
          "202": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingStatus"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PairingRequest"
              }
            }
          }
        },
        "security": []
      }
    },
    "/pairing/v1/requests/{requestId}": {
      "get": {
        "operationId": "getPairingStatus",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PairingStatus"
                }
              }
            }
          },
          "default": {
            "description": "Typed failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ApiError"
                }
              }
            }
          }
        },
        "parameters": [
          {
            "name": "requestId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "security": []
      }
    }
  },
  "components": {
    "securitySchemes": {
      "mutualTls": {
        "type": "mutualTLS"
      }
    },
    "schemas": {
      "ApiError": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "message",
          "retryable",
          "requestId"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "message": {
            "type": "string",
            "maxLength": 256
          },
          "retryable": {
            "type": "boolean"
          },
          "requestId": {
            "type": "string",
            "maxLength": 64
          }
        }
      },
      "ServerInfo": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deviceId",
          "displayName",
          "appVersion",
          "buildNumber",
          "protocolVersion"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "appVersion": {
            "type": "string"
          },
          "buildNumber": {
            "type": "integer",
            "format": "int64",
            "minimum": 1
          },
          "protocolVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 1
          }
        }
      },
      "Share": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "writable"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string",
            "maxLength": 128
          },
          "writable": {
            "type": "boolean"
          }
        }
      },
      "ShareList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Share"
            }
          }
        }
      },
      "FileEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "relativePath",
          "kind",
          "size",
          "modifiedAt"
        ],
        "properties": {
          "name": {
            "type": "string",
            "maxLength": 255
          },
          "relativePath": {
            "type": "string",
            "maxLength": 4096
          },
          "kind": {
            "type": "string",
            "enum": [
              "file",
              "directory"
            ]
          },
          "size": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "modifiedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "FileList": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FileEntry"
            }
          },
          "nextCursor": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "CreateTransfer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "shareId",
          "relativePath",
          "totalSize",
          "sha256",
          "idempotencyKey"
        ],
        "properties": {
          "shareId": {
            "type": "string",
            "format": "uuid"
          },
          "relativePath": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4096
          },
          "totalSize": {
            "type": "integer",
            "format": "int64",
            "minimum": 0,
            "maximum": 1099511627776
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "Transfer": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "transferId",
          "fileName",
          "totalSize",
          "transferredBytes",
          "sha256",
          "status",
          "updatedAt"
        ],
        "properties": {
          "transferId": {
            "type": "string",
            "format": "uuid"
          },
          "fileName": {
            "type": "string",
            "maxLength": 255
          },
          "totalSize": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "transferredBytes": {
            "type": "integer",
            "format": "int64",
            "minimum": 0
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "status": {
            "type": "string",
            "enum": [
              "created",
              "transferring",
              "paused",
              "verifying",
              "completed",
              "failed",
              "cancelled"
            ]
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "SendText": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "content",
          "idempotencyKey"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "plainText",
              "url"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65536
          },
          "idempotencyKey": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "TextEntry": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "content",
          "createdAt",
          "sourceDeviceId"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "plainText",
              "url"
            ]
          },
          "content": {
            "type": "string",
            "maxLength": 65536
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "sourceDeviceId": {
            "type": "string",
            "format": "uuid"
          }
        }
      },
      "TextHistory": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "items",
          "nextCursor"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/TextEntry"
            }
          },
          "nextCursor": {
            "type": "string",
            "maxLength": 256
          }
        }
      },
      "PairingQr": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "protocolVersion",
          "deviceId",
          "displayName",
          "endpoint",
          "serverSpkiSha256",
          "token",
          "expiresAt"
        ],
        "properties": {
          "protocolVersion": {
            "type": "integer",
            "format": "int64",
            "minimum": 1,
            "maximum": 1
          },
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "endpoint": {
            "type": "string",
            "format": "uri"
          },
          "serverSpkiSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "PairingRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "deviceId",
          "displayName",
          "token",
          "certificateDer",
          "proofSignature"
        ],
        "properties": {
          "deviceId": {
            "type": "string",
            "format": "uuid"
          },
          "displayName": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "token": {
            "type": "string",
            "minLength": 43,
            "maxLength": 43
          },
          "certificateDer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          },
          "proofSignature": {
            "type": "string",
            "minLength": 1,
            "maxLength": 2048
          }
        }
      },
      "PairingStatus": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "requestId",
          "status"
        ],
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "approved",
              "denied",
              "expired"
            ]
          }
        }
      }
    }
  }
}
